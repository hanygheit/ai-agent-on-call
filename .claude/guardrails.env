# shellcheck shell=bash
# ─────────────────────────────────────────────────────────────────────────────
#  guardrails.env — the ONE file you tune to adapt this starter to your project.
#  Every hook in .claude/hooks/ reads it. Patterns are case-insensitive
#  extended regular expressions (grep -Ei), matched against the full command.
#  Changing this file changes what agents may do: it is CODEOWNERS-protected.
# ─────────────────────────────────────────────────────────────────────────────

GUARDRAILS_NAME="ai-agent-on-call starter"

# ── Rule 15 · DENY: irreversible or high-blast-radius. Blocked even if asked. ──
DENY_PATTERNS=(
  'kubectl[[:space:]]+delete[[:space:]]+(ns|namespaces?)([[:space:]]|$)'
  'kubectl[[:space:]]+delete[[:space:]].*--all([[:space:]]|$)'
  'terraform[[:space:]]+destroy'
  'terraform[[:space:]]+apply[[:space:]].*-destroy'
  '(drop|truncate)[[:space:]]+(table|database|schema)'
  'volumeDelete'                                  # the PocketOS call (Apr 2026)
  'rm[[:space:]]+-[a-z]*r[a-z]*[[:space:]]+(/|~|\$HOME|\*)([[:space:]]|$)'
  'git[[:space:]]+push([[:space:]].*)?[[:space:]](-f|--force)([[:space:]]|$)'
  'git[[:space:]]+push([[:space:]].*)?([[:space:]]|:)(main|master)([[:space:]]|$)'   # agents never push to main
  'curl[[:space:]].*-X[[:space:]]*DELETE'
  'aws[[:space:]]+s3[[:space:]]+(rb|rm[[:space:]].*--recursive)'
  'aws[[:space:]].*[[:space:]](delete-db-instance|delete-db-cluster|delete-bucket)'
  'gcloud[[:space:]].*[[:space:]](projects|sql[[:space:]]+instances)[[:space:]]+delete'
  'az[[:space:]]+group[[:space:]]+delete'
)

# ── Rule 14 · ASK: changes shared state. The agent proposes; a human presses it. ──
ASK_PATTERNS=(
  'kubectl[[:space:]]+(delete|scale|apply|patch|edit|replace|drain|cordon|taint|set)'
  'kubectl[[:space:]]+rollout[[:space:]]+(undo|restart|resume)'
  'helm[[:space:]]+(install|upgrade|rollback|uninstall)'
  'terraform[[:space:]]+(apply|import|state[[:space:]]+(rm|mv))'
  'git[[:space:]]+push'
  'gh[[:space:]]+pr[[:space:]]+merge'
  '(npm|pnpm|yarn)[[:space:]]+publish'
  'docker[[:space:]]+push'
  'aws[[:space:]].*[[:space:]](delete|terminate|put|update|modify|create)-'
  'gcloud[[:space:]].*[[:space:]](delete|deploy|update)'
  'az[[:space:]].*[[:space:]](delete|update|create)'
)

# ── Change freeze: extra commands blocked while .claude/FREEZE exists. ──
#    (Everything in DENY/ASK is already blocked during a freeze.)
FREEZE_EXTRA_PATTERNS=(
  'git[[:space:]]+(commit|merge|rebase|cherry-pick|tag)'
  '(npm|pnpm|yarn)[[:space:]]+(install|add|remove|update)'
)

# ── Read-only mode (used by the oncall-triage agent): ONLY these may run. ──
READ_ONLY_ALLOW=(
  '^kubectl[[:space:]]+(get|describe|logs|top|events|explain|version|api-resources)([[:space:]]|$)'
  '^kubectl[[:space:]]+rollout[[:space:]]+(history|status)([[:space:]]|$)'
  '^git[[:space:]]+(status|log|diff|show|blame|branch)([[:space:]]|$)'
  '^(cat|head|tail|grep|rg|ls|wc|jq|date|echo)([[:space:]]|$)'
  '^helm[[:space:]]+(list|status|history|get)([[:space:]]|$)'
)

# ── Protected files · Rule 06/15 ──
# DENY: never read or written by an agent (secrets). Glob-style, matched on path.
PROTECTED_DENY_GLOBS=(
  '.env' '.env.*' '*/.env' '*/.env.*'
  'secrets/*' '*/secrets/*'
  '*.pem' '*.key' '*id_rsa*' '*.tfstate' '*.tfstate.*'
  '*credentials*.json' '*.kubeconfig' '*/.kube/config'
)
# ASK: an agent may propose edits, but a human approves (guardrails + CI).
PROTECTED_ASK_GLOBS=(
  '.claude/*' '*/.claude/*'
  'AGENTS.md' '*/AGENTS.md' 'CLAUDE.md' '*/CLAUDE.md'
  '.github/*' '*/.github/*'
  'ops/*' '*/ops/*'
)
# Files that may look like secrets but are safe to read.
PROTECTED_ALLOW_GLOBS=( '.env.example' '*/.env.example' )

# ── Rule 16 · action budget ──
ACTION_BUDGET_PER_MINUTE=10      # Bash calls per session per rolling minute
ACTION_BUDGET_PER_HOUR=120

# ── Rule 17/18 · audit log (same sink as human actions, ideally) ──
AUDIT_LOG_PATH=".claude/logs/agent-actions.jsonl"   # relative to project root

# ── Notification: Slack/Teams incoming-webhook URL comes from the ENVIRONMENT
#    (ONCALL_WEBHOOK_URL), never from this file. Never commit webhook URLs.
